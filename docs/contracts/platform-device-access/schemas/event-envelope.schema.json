{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jushan/contracts/platform-device-access/schemas/event-envelope.schema.json",
  "title": "EventEnvelope",
  "description": "Device Access → Platform 统一事件信封（DRAFT FOR JOINT REVIEW）",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "protocolVersion",
    "schemaVersion",
    "tenantId",
    "parkingLotId",
    "platformDeviceId",
    "deviceSn",
    "vendor",
    "occurredAt",
    "receivedAt",
    "traceId",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": {
      "type": "string",
      "enum": [
        "PLATE_RECOGNIZED",
        "DEVICE_ONLINE",
        "DEVICE_OFFLINE",
        "DEVICE_HEARTBEAT",
        "GATE_STATUS_CHANGED",
        "DEVICE_ALARM",
        "COMMAND_RESULT",
        "IMAGE_UPLOADED",
        "DEVICE_CONFIG_APPLIED"
      ]
    },
    "protocolVersion": { "type": "string", "const": "1.0" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "tenantId": { "type": "string", "minLength": 1 },
    "parkingLotId": { "type": "string", "minLength": 1 },
    "laneId": { "type": "string" },
    "platformDeviceId": { "type": "string", "minLength": 1 },
    "deviceCode": { "type": "string" },
    "deviceSn": { "type": "string", "minLength": 1 },
    "deviceType": { "type": "string", "enum": ["CAMERA", "GATE"] },
    "vendor": { "type": "string", "minLength": 1 },
    "vendorEventId": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "sequenceNo": { "type": "integer", "minimum": 0 },
    "offline": { "type": "boolean" },
    "traceId": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "extensions": {
      "type": "object",
      "description": "≤16KB，禁止放图片 Base64/密钥"
    }
  },
  "additionalProperties": false
}
