{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jushan/contracts/platform-device-access/schemas/plate-recognized-event.schema.json",
  "title": "PlateRecognizedEventPayload",
  "description": "PLATE_RECOGNIZED 事件 payload（DRAFT FOR JOINT REVIEW）",
  "type": "object",
  "required": [
    "recognitionStatus",
    "plateColor",
    "vehicleType",
    "direction",
    "triggerType"
  ],
  "properties": {
    "recognitionStatus": {
      "type": "string",
      "enum": ["SUCCESS", "NO_PLATE", "FAILED", "LOW_CONFIDENCE", "UNKNOWN"]
    },
    "plateNo": { "type": "string", "description": "原始车牌号，NO_PLATE/FAILED 时可空" },
    "normalizedPlateNo": { "type": "string", "description": "标准化车牌号" },
    "plateColor": {
      "type": "string",
      "enum": ["BLUE", "GREEN", "YELLOW", "WHITE", "BLACK", "GRADIENT_GREEN", "YELLOW_GREEN", "OTHER", "UNKNOWN"]
    },
    "vehicleType": {
      "type": "string",
      "enum": ["SMALL", "MEDIUM", "LARGE", "MOTORCYCLE", "OTHER", "UNKNOWN"]
    },
    "energyType": {
      "type": "string",
      "enum": ["FUEL", "NEW_ENERGY", "HYBRID", "OTHER", "UNKNOWN"]
    },
    "direction": { "type": "string", "enum": ["ENTRY", "EXIT", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "triggerType": {
      "type": "string",
      "enum": ["AUTO", "MANUAL", "RETRY", "OFFLINE_UPLOAD"]
    },
    "image": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["objectKey", "contentType", "sizeBytes", "sha256"],
          "properties": {
            "objectKey": { "type": "string" },
            "contentType": { "type": "string", "const": "image/jpeg" },
            "sizeBytes": { "type": "integer", "maximum": 10485760 },
            "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "vendorRecordId": { "type": "string" }
  },
  "additionalProperties": false
}
