/* 卡片 */
.proxy-card {
  padding: 36rpx 32rpx;
}

/* 输入区域 */
.input-group {
  margin-bottom: 32rpx;
}
.input-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}
.plate-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  background: var(--background);
  color: var(--text);
}
.search-btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}

/* 错误提示 */
.error-bar {
  background: #fee2e2;
  border: 1rpx solid #fecaca;
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
}
.error-text { font-size: 26rpx; color: var(--danger); }

/* 详情卡片 */
.detail-card { margin-top: 24rpx; }
.plate-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.plate-text {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 4rpx;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}
.detail-label { font-size: 28rpx; color: var(--text-secondary); }
.detail-value { font-size: 28rpx; color: var(--text); }
.detail-value.duration { font-weight: 600; }
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}
.fee-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.fee-label { font-size: 30rpx; color: var(--text); }
.fee-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--danger);
}

/* 支付按钮区 */
.pay-section {
  padding: 0 8rpx;
  margin-top: 32rpx;
}
.btn-pay-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  border-radius: var(--radius-base);
  box-shadow: var(--shadow-button);
  text-align: center;
}
.btn-pay-primary[disabled] {
  background: var(--text-disabled);
  color: #fff;
  box-shadow: none;
}
.pay-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-disabled);
  margin-top: 16rpx;
}

/* 结果页 */
.result-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
  text-align: center;
}
.result-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}
.success-icon { background: #e6f7f1; color: var(--success); border: 4rpx solid var(--success); }
.fail-icon { background: #fee2e2; color: var(--danger); border: 4rpx solid var(--danger); }
.result-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}
.result-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}
.error-msg { color: var(--danger); }
.result-actions {
  width: 100%;
  margin-top: 48rpx;
}
