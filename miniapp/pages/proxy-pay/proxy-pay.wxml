<view class="page">
  <!-- 标题 -->
  <view class="page-header">
    <text class="page-title">代缴停车费</text>
    <text class="page-desc">输入车牌号为他人支付停车费用</text>
  </view>

  <!-- 输入区域 -->
  <view class="card input-card" wx:if="{{!showFee && payResult === null}}">
    <view class="input-group">
      <text class="input-label">车牌号</text>
      <input
        class="plate-input"
        type="text"
        value="{{plateNumber}}"
        placeholder="请输入车牌号，如 京A12345"
        maxlength="10"
        bindinput="onPlateInput"
        auto-focus
      />
    </view>
    <button
      class="btn-primary btn-full search-btn"
      bindtap="onSearch"
      loading="{{searching}}"
      disabled="{{searching}}"
    >
      {{searching ? '查询中...' : '查询费用'}}
    </button>
    <view class="error-bar" wx:if="{{errorMsg}}">
      <text class="error-text">{{errorMsg}}</text>
    </view>
  </view>

  <!-- 费用预览 -->
  <view class="card detail-card" wx:if="{{showFee && payResult === null}}">
    <view class="plate-display">
      <text class="plate-text">{{plateNumberDisplay}}</text>
    </view>

    <view class="detail-row">
      <text class="detail-label">停车场</text>
      <text class="detail-value">{{parkingLotName}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">入场时间</text>
      <text class="detail-value">{{entryTimeText}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">已停时长</text>
      <text class="detail-value duration">{{durationText}}</text>
    </view>

    <view class="divider"></view>

    <view class="fee-display">
      <text class="fee-label">代缴费用</text>
      <text class="fee-amount">¥{{feeText}}</text>
    </view>
  </view>

  <!-- 支付按钮 -->
  <view class="pay-section" wx:if="{{showFee && payable && payResult === null}}">
    <button
      class="btn-pay-primary"
      bindtap="onConfirmPay"
      loading="{{paying}}"
      disabled="{{paying}}"
    >
      {{paying ? '支付中...' : '确认代缴 ¥' + feeText}}
    </button>
    <text class="pay-hint">代缴后费用不可退还</text>
  </view>

  <!-- 无需缴费提示 -->
  <view class="card" wx:if="{{showFee && !payable && payResult === null}}">
    <view class="empty-state">
      <text class="empty-title">无需缴费</text>
      <text class="empty-desc">该车牌当前没有待支付费用</text>
    </view>
  </view>

  <!-- 支付成功 -->
  <view class="result-wrap" wx:if="{{payResult === 'success'}}">
    <view class="result-icon success-icon">✓</view>
    <text class="result-title">代缴成功</text>
    <text class="result-desc" wx:if="{{orderNo}}">订单号：{{orderNo}}</text>
    <text class="result-desc">车牌：{{plateNumberDisplay}}</text>
    <text class="result-desc">金额：¥{{amountYuan}}</text>
    <view class="result-actions">
      <button class="btn-primary btn-full" bindtap="goToHome">返回首页</button>
      <button class="btn-secondary btn-full" bindtap="onSearch" style="margin-top: 16rpx;">继续代缴</button>
    </view>
  </view>

  <!-- 支付失败 -->
  <view class="result-wrap" wx:elif="{{payResult === 'fail'}}">
    <view class="result-icon fail-icon">✕</view>
    <text class="result-title">代缴失败</text>
    <text class="result-desc error-msg">{{errorMsg}}</text>
    <view class="result-actions">
      <button class="btn-primary btn-full" bindtap="onConfirmPay">重新代缴</button>
      <button class="btn-secondary btn-full" bindtap="goBack" style="margin-top: 16rpx;">返回</button>
    </view>
  </view>
</view>
