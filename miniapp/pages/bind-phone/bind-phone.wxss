.bind-phone-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: var(--background);
  padding: 60rpx 48rpx;
  box-sizing: border-box;
}

.bind-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
  margin-bottom: 80rpx;
}

.bind-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.bind-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.bind-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 40rpx;
}

.bind-body {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-get-phone {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-base);
  border: none;
  box-shadow: var(--shadow-button);
}

.btn-get-phone[disabled] {
  background: var(--text-disabled);
  box-shadow: none;
}

.skip-bind {
  margin-top: 48rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 16rpx 32rpx;
}

.bind-footer {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-disabled);
}
