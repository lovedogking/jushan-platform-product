.container {
  padding: 24rpx;
  min-height: 100vh;
}

.form-card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-base);
  padding: 28rpx;
  box-shadow: var(--shadow-base);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.picker-value {
  font-size: 30rpx;
  color: var(--text);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.no-plate {
  font-size: 26rpx;
  color: var(--text-disabled);
  padding: 16rpx 0;
}

.form-input {
  font-size: 30rpx;
  color: var(--text);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
  width: 100%;
}

.submit-btn {
  margin-top: 48rpx;
  width: 100%;
  border-radius: var(--radius-base);
}
