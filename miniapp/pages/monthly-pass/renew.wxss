.container {
  padding: 24rpx;
  min-height: 100vh;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.info-card,
.form-card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-base);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-base);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.info-value.highlight {
  color: var(--primary);
  font-weight: 600;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.picker-value {
  font-size: 32rpx;
  color: var(--text);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-weight: 500;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--border);
}

.price-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.price-value {
  font-size: 44rpx;
  color: var(--danger);
  font-weight: 700;
}

.submit-btn {
  margin-top: 40rpx;
  width: 100%;
  border-radius: var(--radius-base);
}
