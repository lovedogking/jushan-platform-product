/* 停车详情卡片 */
.detail-card {
  padding: 36rpx 32rpx;
}

.plate-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.plate-text {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 4rpx;
}
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
  line-height: 1.6;
}
.tag-in { background: var(--primary-light); color: var(--primary); }
.tag-out { background: #f1f5f9; color: var(--text-secondary); }

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}
.detail-label { font-size: 28rpx; color: var(--text-secondary); }
.detail-value { font-size: 28rpx; color: var(--text); }
.detail-value.duration { font-weight: 600; }

.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

.fee-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.fee-label { font-size: 30rpx; color: var(--text); }
.fee-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--danger);
}

.message-hint {
  font-size: 24rpx;
  color: var(--success);
  text-align: right;
}

/* 错误提示 */
.error-bar {
  background: #fee2e2;
  border: 1rpx solid #fecaca;
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.error-text { font-size: 26rpx; color: var(--danger); }

/* 支付按钮区 */
.pay-action {
  text-align: center;
  margin-top: 40rpx;
}

.btn-pay-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  border-radius: var(--radius-base);
  box-shadow: var(--shadow-button);
}
.btn-pay-primary.btn-disabled {
  background: var(--text-disabled);
  color: #fff;
  box-shadow: none;
}
.btn-pay-primary[disabled] {
  background: var(--text-disabled);
  color: #fff;
  box-shadow: none;
}

.pay-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-disabled);
  margin-top: 16rpx;
}

/* 结果页 */
.result-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 60rpx;
  text-align: center;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}
.success-icon { background: #e6f7f1; color: var(--success); border: 4rpx solid var(--success); }
.fail-icon { background: #fee2e2; color: var(--danger); border: 4rpx solid var(--danger); }

.result-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
}
.result-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}
.error-msg { color: var(--danger); }

.result-btn {
  margin-top: 48rpx;
}
