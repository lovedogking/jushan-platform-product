.page {
  padding: 24rpx;
  min-height: 100vh;
  background-color: #F5F7FA;
}

/* 加载 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-text { font-size: 28rpx; color: #b0b8c1; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 停车详情卡片 */
.detail-card {
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
}

.plate-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.plate-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 4rpx;
}
.status-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.tag-in { background: #E6F7FF; color: #1677FF; }
.tag-out { background: #F0F0F0; color: #87989f; }

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}
.detail-label { font-size: 28rpx; color: #87989f; }
.detail-value { font-size: 28rpx; color: #333; }
.detail-value.duration { font-weight: 600; }

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

.fee-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.fee-label { font-size: 30rpx; color: #333; }
.fee-amount {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF4D4F;
}

.message-hint {
  font-size: 24rpx;
  color: #52C41A;
  text-align: right;
}

/* 错误提示 */
.error-bar {
  background: #FFF1F0;
  border: 1rpx solid #FFCCC7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.error-text { font-size: 26rpx; color: #FF4D4F; }

/* 支付按钮区 */
.pay-action {
  text-align: center;
  margin-top: 40rpx;
}

.btn-pay-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #1677FF, #4096FF);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
}
.btn-pay-primary.btn-disabled {
  background: #d9d9d9;
  color: #999;
  box-shadow: none;
}
.btn-pay-primary[disabled] {
  background: #d9d9d9;
  color: #999;
}

.pay-hint {
  display: block;
  font-size: 24rpx;
  color: #b0b8c1;
  margin-top: 16rpx;
}

/* 结果页 */
.result-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 60rpx;
  text-align: center;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}
.success-icon { background: #F6FFED; color: #52C41A; border: 4rpx solid #52C41A; }
.fail-icon { background: #FFF1F0; color: #FF4D4F; border: 4rpx solid #FF4D4F; }

.result-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}
.result-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.error-msg { color: #FF4D4F; }

.result-btn {
  margin-top: 48rpx;
}

/* 通用按钮 */
.btn-primary {
  background: #1677FF;
  color: #fff;
  border: none;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 22rpx 0;
}
.btn-full { width: 100%; }
