.page {
  padding: 24rpx;
}

.notice-card {
  text-align: center;
  padding: 60rpx 24rpx;
  margin-bottom: 24rpx;
}

.notice-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.notice-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.notice-desc {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
}

.form-placeholder {
  padding: 32rpx 24rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.disabled {
  opacity: 0.55;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #999;
  box-sizing: border-box;
}
