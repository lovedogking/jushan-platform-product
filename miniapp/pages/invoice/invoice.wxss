.notice-card {
  text-align: center;
  padding: 60rpx 28rpx;
  margin-bottom: 24rpx;
}

.notice-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.notice-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.notice-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.form-placeholder {
  padding: 32rpx 28rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 28rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item.disabled {
  opacity: 0.45;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--background);
  border: 1rpx solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-disabled);
  box-sizing: border-box;
}
