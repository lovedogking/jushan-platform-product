/* 消息卡片 */
.msg-card {
  padding: 28rpx;
}
.msg-card.msg-unread {
  border-left: 6rpx solid var(--primary);
}
.msg-card.msg-read {
  border-left: 6rpx solid transparent;
}
.msg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.msg-type-area {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.msg-unread-dot {
  font-size: 24rpx;
  color: var(--primary);
  line-height: 1;
}
.msg-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}
.type-pay {
  background: #e6f7f1;
  color: var(--success-dark);
}
.type-system {
  background: var(--primary-light);
  color: var(--primary);
}
.msg-time {
  font-size: 22rpx;
  color: var(--text-disabled);
}

.msg-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.msg-preview {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.msg-plate {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}
.msg-amount {
  font-size: 28rpx;
  color: var(--danger);
  font-weight: 700;
}

.msg-content {
  margin-top: 4rpx;
}
.msg-content-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
