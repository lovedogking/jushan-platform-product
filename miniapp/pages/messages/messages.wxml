<view class="page">
  <!-- 头部 -->
  <view class="page-header">
    <text class="page-title">消息中心</text>
    <text class="page-desc" wx:if="{{total > 0}}">共 {{total}} 条消息</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading && messages.length === 0}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="card" wx:if="{{!loading && messages.length === 0}}">
    <view class="empty-state">
      <view class="empty-icon">📭</view>
      <text class="empty-title">暂无消息</text>
      <text class="empty-desc">当有支付成功等通知时，将显示在这里</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <block wx:for="{{messages}}" wx:key="id">
    <view
      class="card msg-card {{item.isRead ? 'msg-read' : 'msg-unread'}}"
      bindtap="onMessageTap"
      data-message="{{item}}"
    >
      <view class="msg-header">
        <view class="msg-type-area">
          <text class="msg-unread-dot" wx:if="{{!item.isRead}}">●</text>
          <text class="msg-type {{item.type === 'PAY_SUCCESS' ? 'type-pay' : 'type-system'}}">
            {{item.type === 'PAY_SUCCESS' ? '支付通知' : '系统通知'}}
          </text>
        </view>
        <text class="msg-time">{{item.timeText}}</text>
      </view>

      <view class="msg-title">{{item.title}}</view>

      <view class="msg-preview" wx:if="{{item.relatedPlate || item.relatedAmountYuan}}">
        <text class="msg-plate" wx:if="{{item.relatedPlate}}">{{item.relatedPlate}}</text>
        <text class="msg-amount" wx:if="{{item.relatedAmountYuan}}">¥{{item.relatedAmountYuan}}</text>
      </view>

      <view class="msg-content" wx:if="{{item.content}}">
        <text class="msg-content-text">{{item.content}}</text>
      </view>
    </view>
  </block>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{loading && messages.length > 0}}">
    <text>加载更多...</text>
  </view>

  <!-- 底部提示 -->
  <view class="footer-tip" wx:if="{{!loading && messages.length > 0}}">
    <text>点击消息查看详情</text>
  </view>
</view>
