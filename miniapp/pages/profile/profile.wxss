.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  background: var(--primary);
  border-radius: 50%;
  box-shadow: var(--shadow-button);
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  color: var(--text);
  font-size: 34rpx;
  font-weight: 700;
}

.phone {
  color: var(--text-secondary);
  font-size: 26rpx;
}

.menu-card {
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: var(--text);
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item:active {
  opacity: 0.6;
}

.menu-arrow {
  color: var(--text-disabled);
  font-size: 32rpx;
  font-weight: 300;
}
