<view class="page">
  <!-- 未登录状态 -->
  <view class="card" wx:if="{{!isLoggedIn}}">
    <view class="empty-state">
      <text class="empty-title">尚未登录</text>
      <text class="empty-desc">请先在首页完成微信授权登录</text>
    </view>
  </view>

  <!-- 已登录状态 -->
  <block wx:if="{{isLoggedIn}}">
    <!-- 用户信息卡片 -->
    <view class="card">
      <view class="profile-header">
        <view class="avatar">{{avatarText}}</view>
        <view class="profile-info">
          <text class="nickname">{{displayName}}</text>
          <text class="phone">{{phone || '未绑定手机号'}}</text>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="card menu-card">
      <view class="menu-item" bindtap="goToMessages">
        <text>消息中心</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToVehicles">
        <text>我的车辆</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToMonthCards">
        <text>我的月卡</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToFixedSpaces">
        <text>固定车位</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToCoupons">
        <text>优惠券</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToInvoice">
        <text>电子发票</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="card" style="margin-top: 32rpx;">
      <button class="btn-danger btn-full" bindtap="handleLogout">
        退出登录
      </button>
    </view>
  </block>
</view>
