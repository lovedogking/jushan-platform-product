<view class="page">
  <!-- 头部 -->
  <view class="page-header">
    <text class="page-title">余位查询</text>
    <text class="page-desc">查看各停车场实时剩余车位</text>
  </view>

  <!-- 模式切换 -->
  <view class="mode-bar" wx:if="{{!loading}}">
    <view class="mode-tabs">
      <view
        class="mode-tab {{!showAll ? 'mode-tab-active' : ''}}"
        bindtap="switchToNearby"
      >
        <text>附近车场</text>
      </view>
      <view
        class="mode-tab {{showAll ? 'mode-tab-active' : ''}}"
        bindtap="switchToList"
      >
        <text>全部车场</text>
      </view>
    </view>
    <view class="refresh-area">
      <text class="refresh-time" wx:if="{{lastRefreshTime}}">{{lastRefreshTime}} 更新</text>
      <text class="refresh-btn" bindtap="refreshData" wx:if="{{!refreshing}}">刷新</text>
      <text class="refresh-btn refreshing" wx:else>刷新中...</text>
    </view>
  </view>

  <!-- 定位授权提示 -->
  <view class="card location-card" wx:if="{{locationAuthDenied && !showAll}}">
    <text class="location-tip">未获取到位置信息，已为您显示全部车场</text>
    <button class="btn-link" bindtap="reAuthLocation">去授权</button>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar" wx:if="{{!loading && lots.length > 0}}">
    <input
      class="search-input"
      type="text"
      placeholder="搜索车场名称或地址"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误提示 -->
  <view class="card" wx:if="{{!loading && errorMsg}}">
    <view class="empty-state">
      <text class="empty-title">加载失败</text>
      <text class="empty-desc">{{errorMsg}}</text>
      <button class="btn-primary btn-full" bindtap="refreshData">重试</button>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="card" wx:if="{{!loading && !errorMsg && filteredLots.length === 0}}">
    <view class="empty-state">
      <text class="empty-title">暂无可用车场</text>
      <text class="empty-desc" wx:if="{{!showAll}}">附近未找到有空位的停车场</text>
      <text class="empty-desc" wx:else>暂无启用的停车场</text>
    </view>
  </view>

  <!-- 车场列表 -->
  <block wx:for="{{filteredLots}}" wx:key="id">
    <view
      class="card lot-card"
      bindtap="goToLot"
      data-id="{{item.id}}"
      data-lat="{{item.latitude}}"
      data-lng="{{item.longitude}}"
    >
      <view class="lot-header">
        <view class="lot-info">
          <text class="lot-name">{{item.name}}</text>
          <text class="lot-address" wx:if="{{item.address}}">{{item.address}}</text>
        </view>
        <view class="remain-display {{item.remainClass}}">
          <text class="remain-number">{{item.remainText}}</text>
          <text class="remain-label">余位</text>
        </view>
      </view>
      <view class="lot-footer">
        <text class="lot-stat">总车位 {{item.totalSpaces || 0}}</text>
        <text class="lot-stat">在场 {{item.currentVehicles || 0}}</text>
        <text class="lot-distance" wx:if="{{item.distanceText}}">距您 {{item.distanceText}}</text>
      </view>
    </view>
  </block>

  <!-- 自动刷新提示 -->
  <view class="footer-tip" wx:if="{{!loading && lots.length > 0}}">
    <text>数据每 5 分钟自动刷新</text>
  </view>
</view>
