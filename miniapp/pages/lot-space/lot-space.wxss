.page {
  min-height: 100vh;
  padding: 24rpx;
  background-color: #F5F7FA;
}

/* 头部 */
.page-header {
  text-align: center;
  padding: 32rpx 0 20rpx;
}
.page-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.page-desc {
  display: block;
  font-size: 26rpx;
  color: #87989f;
  margin-top: 8rpx;
}

/* 模式切换栏 */
.mode-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.mode-tabs {
  display: flex;
  background: #e8ecf1;
  border-radius: 12rpx;
  padding: 4rpx;
}
.mode-tab {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #6b7a90;
  border-radius: 10rpx;
}
.mode-tab-active {
  background: #fff;
  color: #1677FF;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.refresh-area {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.refresh-time {
  font-size: 22rpx;
  color: #b0b8c1;
}
.refresh-btn {
  font-size: 24rpx;
  color: #1677FF;
  padding: 8rpx 12rpx;
}
.refresh-btn.refreshing {
  color: #b0b8c1;
}

/* 定位授权提示 */
.location-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}
.location-tip {
  font-size: 24rpx;
  color: #ff9500;
  flex: 1;
}
.btn-link {
  font-size: 24rpx;
  color: #1677FF;
  padding: 8rpx 16rpx;
  background: none;
  border: none;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 20rpx;
}
.search-input {
  width: 100%;
  height: 72rpx;
  background: #fff;
  border: 2rpx solid #e5eaf3;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #333;
}
.search-input:focus {
  border-color: #1677FF;
}

/* 加载 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}
.loading-text { font-size: 28rpx; color: #b0b8c1; }

/* 空状态 */
.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  text-align: center;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.empty-desc {
  font-size: 26rpx;
  color: #b0b8c1;
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

/* 车场卡片 */
.lot-card {
  padding: 28rpx 28rpx;
}
.lot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.lot-info {
  flex: 1;
  margin-right: 20rpx;
}
.lot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}
.lot-address {
  font-size: 24rpx;
  color: #87989f;
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 余位显示 */
.remain-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 96rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #F0FFF4;
}
.remain-display.remain-ok {
  background: #F0FFF4;
}
.remain-display.remain-low {
  background: #FFF7E6;
}
.remain-display.remain-full {
  background: #FFF1F0;
}
.remain-display.remain-none {
  background: #f5f5f5;
}
.remain-number {
  font-size: 40rpx;
  font-weight: 800;
  color: #00b578;
  line-height: 1.1;
}
.remain-ok .remain-number { color: #00b578; }
.remain-low .remain-number { color: #ff9500; }
.remain-full .remain-number { color: #f53f3f; font-size: 28rpx; }
.remain-none .remain-number { color: #b0b8c1; font-size: 28rpx; }
.remain-label {
  font-size: 20rpx;
  color: #6b7a90;
  margin-top: 4rpx;
}

/* 底部信息 */
.lot-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.lot-stat {
  font-size: 22rpx;
  color: #b0b8c1;
}
.lot-distance {
  font-size: 22rpx;
  color: #1677FF;
  margin-left: auto;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  padding: 20rpx 0 40rpx;
  font-size: 24rpx;
  color: #d0d5de;
}

/* 通用按钮 */
.btn-primary {
  background: #1677FF;
  color: #fff;
  border: none;
  font-size: 30rpx;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
}
.btn-full { width: 100%; }
