/* 模式切换栏 */
.mode-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.mode-tabs {
  display: flex;
  background: var(--background);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 6rpx;
}
.mode-tab {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
}
.mode-tab-active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-button);
}
.refresh-area {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.refresh-time {
  font-size: 22rpx;
  color: var(--text-disabled);
}
.refresh-btn {
  font-size: 24rpx;
  color: var(--primary);
  padding: 8rpx 12rpx;
  font-weight: 500;
}
.refresh-btn.refreshing {
  color: var(--text-disabled);
}

/* 定位授权提示 */
.location-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
}
.location-tip {
  font-size: 24rpx;
  color: var(--warning);
  flex: 1;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 24rpx;
}
.search-input {
  width: 100%;
  height: 80rpx;
  background: var(--card);
  border: 1rpx solid var(--border-strong);
  border-radius: var(--radius-base);
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--text);
}

/* 车场卡片 */
.lot-card {
  padding: 28rpx;
}
.lot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.lot-info {
  flex: 1;
  margin-right: 20rpx;
}
.lot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  display: block;
}
.lot-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 余位显示 */
.remain-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 96rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-sm);
}
.remain-display.remain-ok {
  background: #e6f7f1;
}
.remain-display.remain-low {
  background: #fef3e2;
}
.remain-display.remain-full {
  background: #fee2e2;
}
.remain-display.remain-none {
  background: #f1f5f9;
}
.remain-number {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--success);
  line-height: 1.1;
}
.remain-ok .remain-number { color: var(--success); }
.remain-low .remain-number { color: var(--warning); }
.remain-full .remain-number { color: var(--danger); font-size: 32rpx; }
.remain-none .remain-number { color: var(--text-disabled); font-size: 32rpx; }
.remain-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 底部信息 */
.lot-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}
.lot-stat {
  font-size: 22rpx;
  color: var(--text-disabled);
}
.lot-distance {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 500;
  margin-left: auto;
}
