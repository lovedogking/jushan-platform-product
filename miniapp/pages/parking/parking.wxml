<view class="page">
  <!-- 车牌筛选 -->
  <view class="plate-filter card" wx:if="{{plates.length > 1}}">
    <text class="filter-label">车牌筛选</text>
    <picker mode="selector" range="{{plates}}" bindchange="onPlateChange">
      <view class="picker-value">
        <text>{{filterPlate || '全部车牌'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 记录列表 -->
  <view class="records-list">
    <block wx:for="{{records}}" wx:key="recordId">
      <view class="card record-card {{item.payStatus === 'UNPAID' ? 'unpaid-card' : ''}}" bindtap="goToPay" data-record-id="{{item.recordId}}">
        <view class="record-header">
          <text class="plate-number">{{item.plateNumber}}</text>
          <view class="status-row">
            <text class="status-badge {{item.status === 'IN' ? 'status-in' : 'status-out'}}">{{item.statusText}}</text>
            <text class="pay-badge {{item.payStatus === 'UNPAID' ? 'pay-unpaid' : item.payStatus === 'PAID' ? 'pay-paid' : 'pay-free'}}">{{item.payStatusText}}</text>
          </view>
        </view>
        <view class="record-row">
          <text class="label">停车场</text>
          <text class="value">{{item.parkingLotName || '未知'}}</text>
        </view>
        <view class="record-row">
          <text class="label">入场时间</text>
          <text class="value">{{item.entryTimeText}}</text>
        </view>
        <view class="record-row" wx:if="{{item.exitTimeText}}">
          <text class="label">出场时间</text>
          <text class="value">{{item.exitTimeText}}</text>
        </view>
        <view class="record-row">
          <text class="label">停车时长</text>
          <text class="value">{{item.durationText}}</text>
        </view>
        <view class="record-row">
          <text class="label">费用</text>
          <text class="value fee {{item.payStatus === 'UNPAID' ? 'fee-unpaid' : ''}}">¥{{item.feeText}}</text>
        </view>
        <view class="record-action" wx:if="{{item.payStatus === 'UNPAID'}}">
          <text class="action-hint">点击立即缴费 ›</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{records.length === 0 && !loading}}">
    <text class="empty-title">暂无停车记录</text>
    <text class="empty-desc">{{filterPlate ? '该车牌暂无停车记录' : '您还没有产生停车记录'}}</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more-wrap" wx:if="{{records.length > 0}}">
    <view wx:if="{{loading}}" class="loading-text">加载中...</view>
    <view wx:elif="{{!hasMore}}" class="no-more-text">没有更多了</view>
    <button wx:else class="btn-secondary btn-full load-more-btn" bindtap="loadMore">加载更多</button>
  </view>
</view>
