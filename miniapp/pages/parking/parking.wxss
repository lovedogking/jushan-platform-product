.page {
  padding: 20rpx 24rpx 40rpx;
  min-height: 100vh;
  background-color: #F5F7FA;
}

/* 车牌筛选 */
.plate-filter {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}
.filter-label { font-size: 28rpx; color: #333; }
.picker-value { display: flex; align-items: center; font-size: 28rpx; color: #1677FF; }
.picker-arrow { font-size: 22rpx; margin-left: 8rpx; }

/* 记录卡片 */
.records-list { margin-bottom: 16rpx; }
.record-card {
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.unpaid-card {
  border-left: 6rpx solid #FF6B6B;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.plate-number {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.status-row {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}
.record-row .label { font-size: 26rpx; color: #87989f; }
.record-row .value { font-size: 26rpx; color: #333; }

/* 状态标签 */
.status-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}
.status-in { background: #E6F7FF; color: #1677FF; }
.status-out { background: #F0F0F0; color: #87989f; }

.pay-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}
.pay-unpaid { background: #FFF1F0; color: #FF4D4F; font-weight: 600; }
.pay-paid { background: #F6FFED; color: #52C41A; }
.pay-free { background: #F0F0F0; color: #87989f; }

/* 费用高亮 */
.fee { font-weight: 600; }
.fee-unpaid { color: #FF4D4F; font-size: 30rpx; }

/* 操作提示 */
.record-action {
  text-align: right;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}
.action-hint { font-size: 26rpx; color: #1677FF; }

/* 加载更多 */
.load-more-wrap { text-align: center; padding: 20rpx 0; }
.loading-text, .no-more-text { font-size: 26rpx; color: #b0b8c1; padding: 16rpx 0; }
.load-more-btn { margin: 8rpx 0; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-title { font-size: 32rpx; color: #333; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #b0b8c1; text-align: center; }

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.btn-secondary {
  background: #f0f0f0;
  color: #666;
  border: none;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 20rpx 0;
}
.btn-full { width: 100%; }
