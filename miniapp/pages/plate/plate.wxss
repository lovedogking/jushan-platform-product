.plate-page {
  padding-top: 24rpx;
}

.backend-tip {
  margin: 0 24rpx 20rpx;
  padding: 18rpx 24rpx;
  background: #fef3e2;
  border: 1rpx solid #fde6c8;
  border-radius: var(--radius-base);
  color: #b45309;
  font-size: 26rpx;
  line-height: 1.5;
}

.add-card {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.plate-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--background);
  border: 1rpx solid var(--border-strong);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text);
}

.btn-add {
  width: auto;
  min-width: 176rpx;
}

.list-card {
  padding: 8rpx 28rpx;
}

.plate-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.plate-item:last-child {
  border-bottom: none;
}

.plate-main {
  flex: 1;
  min-width: 0;
}

.plate-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.plate-number {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 1rpx;
}

.default-tag {
  padding: 2rpx 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--success-dark);
  background: #e6f7f1;
  border-radius: var(--radius-sm);
}

.plate-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.meta-sep {
  margin: 0 10rpx;
}

.plate-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-action {
  min-height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-default {
  color: var(--primary);
  background: var(--primary-light);
}

.btn-action.btn-danger {
  color: var(--danger);
  background: #fee2e2;
}

.loading-mask {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-mask .loading-text {
  color: var(--text-secondary);
  font-size: 26rpx;
}
