.container {
  padding: 24rpx;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.apply-btn {
  font-size: 26rpx;
  font-weight: 500;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-base);
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-base);
}

.card-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: var(--text);
}

.card-row:last-child {
  margin-bottom: 0;
}

.plate {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  flex: 1;
  letter-spacing: 1rpx;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
  line-height: 1.6;
}

.status-active {
  color: var(--success-dark);
  background: #e6f7f1;
}

.status-pending {
  color: #b45309;
  background: #fef3e2;
}

.status-review-pending {
  color: var(--warning);
  background: #fef3e2;
}

.status-review-rejected {
  color: var(--danger);
  background: #fee2e2;
}

.status-expired {
  color: var(--text-secondary);
  background: #f1f5f9;
}

.status-cancelled {
  color: var(--text-disabled);
  background: #f1f5f9;
}

.label {
  color: var(--text-secondary);
  font-size: 26rpx;
  margin-right: 8rpx;
}

.card-actions {
  margin-top: 16rpx;
  text-align: right;
}

.action-btn {
  font-size: 24rpx;
  border-radius: var(--radius-sm);
  padding: 8rpx 24rpx;
  font-weight: 500;
}

.pay-btn {
  background: var(--primary);
  color: #fff;
}

.renew-btn {
  background: var(--success);
  color: #fff;
}
