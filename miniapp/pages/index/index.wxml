<view class="page">
  <!-- 未登录状态 -->
  <view class="card" wx:if="{{!loading && !loggedIn}}">
    <view class="welcome-section">
      <text class="welcome-title">欢迎使用智慧停车</text>
      <text class="welcome-desc">请先登录后查看停车记录和在线缴费。</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="empty-state" wx:if="{{loading}}">
    <text class="empty-title">加载中...</text>
  </view>

  <!-- 已登录 -->
  <block wx:if="{{!loading && loggedIn}}">
    <!-- 默认车牌 -->
    <view class="plate-bar card" wx:if="{{plates.length > 0}}">
      <text class="plate-label">当前车牌</text>
      <text class="plate-value">{{defaultPlateText}}</text>
      <text class="plate-action" bindtap="goToPlateManage">管理</text>
    </view>

    <!-- 当前在场车辆 -->
    <view class="section-title" wx:if="{{activeSessions.length > 0}}">当前在场</view>
    <block wx:for="{{activeSessions}}" wx:key="recordId">
      <view class="card session-card active-session">
        <view class="session-header">
          <text class="plate-number">{{item.plateNumber}}</text>
          <text class="status-badge status-in">在场</text>
        </view>
        <view class="session-row">
          <text class="label">停车场</text>
          <text class="value">{{item.parkingLotName || '未知'}}</text>
        </view>
        <view class="session-row">
          <text class="label">入场时间</text>
          <text class="value">{{item.entryTimeText}}</text>
        </view>
        <view class="session-row">
          <text class="label">已停时长</text>
          <text class="value">{{item.durationText}}</text>
        </view>
        <view class="session-row" wx:if="{{item.payStatus === 'UNPAID'}}">
          <text class="label">预估费用</text>
          <text class="value fee">¥{{item.feeText}}</text>
        </view>
        <button class="btn-primary btn-pay" wx:if="{{item.payStatus === 'UNPAID'}}" bindtap="goToPayActive" data-record-id="{{item.recordId || item.id}}">立即缴费</button>
      </view>
    </block>

    <!-- 最近记录 -->
    <view class="section-header">
      <text class="section-title">最近记录</text>
      <text class="section-more" bindtap="goToRecords">查看全部 ›</text>
    </view>

    <block wx:for="{{recentRecords}}" wx:key="recordId">
      <view class="card record-card" bindtap="goToPay" data-record-id="{{item.recordId || item.id}}">
        <view class="record-header">
          <text class="plate-number">{{item.plateNumber}}</text>
          <text class="status-badge {{item.payStatus === 'UNPAID' ? 'status-unpaid' : item.payStatus === 'PAID' ? 'status-paid' : 'status-free'}}">{{item.payStatusText}}</text>
        </view>
        <view class="record-row">
          <text class="label">{{item.parkingLotName || '未知停车场'}}</text>
          <text class="value">{{item.statusText}}</text>
        </view>
        <view class="record-row">
          <text class="label">{{item.entryTimeText}}</text>
          <text class="value fee" wx:if="{{item.payStatus === 'UNPAID'}}">¥{{item.feeText}}</text>
          <text class="value" wx:else>¥{{item.feeText}}</text>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{activeSessions.length === 0 && recentRecords.length === 0}}">
      <text class="empty-title">暂无停车记录</text>
      <text class="empty-desc">绑定车牌后，您的停车记录将显示在这里。</text>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions">
      <button class="btn-primary btn-full" bindtap="goToPlateManage">管理车牌</button>
      <button class="btn-secondary btn-full" bindtap="goToRecords">全部记录</button>
    </view>
  </block>
</view>
