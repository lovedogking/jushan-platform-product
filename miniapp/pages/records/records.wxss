/* 顶部标签栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

/* 记录卡片 */
.records-list {
  margin-top: 0;
}

.record-card {
  margin-bottom: 20rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.lot-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.badge-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.status-badge {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.status-in {
  background: #e6fffb;
  color: #006d75;
}

.status-out {
  background: #f6ffed;
  color: #237804;
}

.status-unpaid {
  background: #fff7e6;
  color: #ad6800;
}

.arrears-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fff1f0;
  color: #cf1322;
  font-weight: 600;
}

.proxy-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f5ff;
  color: #2f54eb;
  font-weight: 600;
}

.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.label {
  color: var(--muted);
  font-size: 26rpx;
}

.value {
  color: var(--text);
  font-size: 26rpx;
  font-weight: 500;
}

.plate {
  font-weight: 700;
  letter-spacing: 1rpx;
}

.fee {
  color: var(--danger);
  font-weight: 700;
}

.fee-completed {
  color: var(--success);
  font-weight: 700;
}

.duration {
  color: var(--primary);
}

/* 支付操作区 */
.pay-action {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.pay-btn {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
}

/* 加载更多 */
.load-more-wrap {
  padding: 24rpx 0 40rpx;
}

.load-more-btn {
  font-size: 28rpx;
}

.loading-text,
.no-more-text {
  text-align: center;
  color: var(--muted);
  padding: 24rpx 0;
}

.loading-text {
  font-size: 26rpx;
}

.no-more-text {
  font-size: 24rpx;
}
