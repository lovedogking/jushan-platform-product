/* 顶部标签栏 */
.tab-bar {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-base);
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-base);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}

.tab-active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-button);
}

/* 记录卡片 */
.record-card {
  margin-bottom: 20rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.lot-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.badge-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
  line-height: 1.6;
}

.status-in { background: var(--primary-light); color: var(--primary); }
.status-out { background: #e6f7f1; color: var(--success-dark); }
.status-unpaid { background: #fef3e2; color: #b45309; }

.arrears-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: #fee2e2;
  color: var(--danger);
  font-weight: 500;
}

.proxy-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 500;
}

.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.label {
  color: var(--text-secondary);
  font-size: 26rpx;
}

.value {
  color: var(--text);
  font-size: 26rpx;
  font-weight: 500;
}

.plate {
  font-weight: 700;
  letter-spacing: 1rpx;
}

.fee {
  color: var(--danger);
  font-weight: 700;
}

.fee-completed {
  color: var(--success);
  font-weight: 700;
}

.duration {
  color: var(--primary);
}

/* 支付操作区 */
.pay-action {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.pay-btn {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 0;
}

/* 加载更多 */
.load-more-wrap {
  padding: 24rpx 0 40rpx;
}

.load-more-btn {
  font-size: 28rpx;
}

.loading-text,
.no-more-text {
  text-align: center;
  color: var(--text-secondary);
  padding: 24rpx 0;
}

.loading-text {
  font-size: 26rpx;
}

.no-more-text {
  font-size: 24rpx;
  color: var(--text-disabled);
}
