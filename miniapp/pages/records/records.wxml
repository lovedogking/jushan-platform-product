<view class="page">
  <!-- 顶部标签栏 -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="switchTab"
    >{{item.label}}</view>
  </view>

  <!-- 在场中 -->
  <view wx:if="{{activeTab === 'in_progress'}}" class="records-list">
    <block wx:for="{{records}}" wx:key="id">
      <view class="record-card card">
        <view class="record-header">
          <text class="lot-name">{{item.parkingLotName || '未知车场'}}</text>
          <text class="status-badge status-in">在场</text>
        </view>
        <view class="record-row">
          <text class="label">车牌号</text>
          <text class="value plate">{{item.plateNumber}}</text>
        </view>
        <view class="record-row">
          <text class="label">入场时间</text>
          <text class="value">{{item.entryTimeText}}</text>
        </view>
        <view class="record-row">
          <text class="label">已停时长</text>
          <text class="value duration">{{item.durationText}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 待支付（含欠费） -->
  <view wx:if="{{activeTab === 'pending_pay'}}" class="records-list">
    <block wx:for="{{records}}" wx:key="id">
      <view class="record-card card" bindtap="goToPay" data-record-id="{{item.recordId || item.id}}">
        <view class="record-header">
          <text class="lot-name">{{item.parkingLotName || '未知车场'}}</text>
          <view class="badge-row">
            <text wx:if="{{item.isArrears}}" class="arrears-badge">欠费</text>
            <text class="status-badge status-unpaid">待支付</text>
          </view>
        </view>
        <view class="record-row">
          <text class="label">车牌号</text>
          <text class="value plate">{{item.plateNumber}}</text>
        </view>
        <view class="record-row">
          <text class="label">入场时间</text>
          <text class="value">{{item.entryTimeText}}</text>
        </view>
        <view class="record-row">
          <text class="label">金额</text>
          <text class="value fee">¥{{item.feeText}}</text>
        </view>
        <view class="record-row">
          <text class="label">已停时长</text>
          <text class="value duration">{{item.durationText}}</text>
        </view>
        <view class="pay-action">
          <text class="pay-btn">去支付 ›</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 已完成 -->
  <view wx:if="{{activeTab === 'completed'}}" class="records-list">
    <block wx:for="{{records}}" wx:key="id">
      <view class="record-card card">
        <view class="record-header">
          <text class="lot-name">{{item.parkingLotName || '未知车场'}}</text>
          <view class="badge-row">
            <text wx:if="{{item.isProxyPay}}" class="proxy-badge">代缴</text>
            <text class="status-badge status-out">已完成</text>
          </view>
        </view>
        <view class="record-row">
          <text class="label">车牌号</text>
          <text class="value plate">{{item.plateNumber}}</text>
        </view>
        <view class="record-row">
          <text class="label">金额</text>
          <text class="value fee-completed">¥{{item.feeText}}</text>
        </view>
        <view class="record-row">
          <text class="label">入场时间</text>
          <text class="value">{{item.entryTimeText}}</text>
        </view>
        <view wx:if="{{item.exitTimeText}}" class="record-row">
          <text class="label">出场时间</text>
          <text class="value">{{item.exitTimeText}}</text>
        </view>
        <view class="record-row">
          <text class="label">停车时长</text>
          <text class="value">{{item.durationText}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{records.length === 0 && !loading}}" class="empty-state">
    <text class="empty-title">暂无记录</text>
    <text class="empty-desc">当前分类下没有停车记录</text>
  </view>

  <!-- 加载更多 -->
  <view wx:if="{{records.length > 0}}" class="load-more-wrap">
    <button wx:if="{{hasMore && !loading}}" class="btn-primary btn-full load-more-btn" bindtap="loadMore">加载更多</button>
    <view wx:if="{{loading}}" class="loading-text">加载中...</view>
    <view wx:if="{{!hasMore && !loading}}" class="no-more-text">没有更多了</view>
  </view>
</view>
