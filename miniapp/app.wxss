page {
  --primary: #1677ff;
  --success: #00b578;
  --warning: #ff9500;
  --danger: #f53f3f;
  --background: #f5f7fa;
  --card: #ffffff;
  --text: #102a43;
  --muted: #6b7a90;
  --border: #e5eaf3;

  min-height: 100vh;
  color: var(--text);
  background: var(--background);
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 27rpx;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, image, scroll-view {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent;
  border: 0;
  border-radius: 0;
}

button::after {
  border: 0;
}

image {
  display: block;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(168rpx + env(safe-area-inset-bottom));
  background: var(--background);
}

.card {
  padding: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 42, 68, 0.07);
  margin-bottom: 20rpx;
}

.btn-primary {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1677ff, #165dff);
  box-shadow: 0 10rpx 22rpx rgba(22, 119, 255, 0.22);
}

.btn-full {
  width: 100%;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 8rpx 8rpx;
  text-align: center;
}

.empty-title {
  color: var(--text);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.empty-desc {
  max-width: 520rpx;
  margin: 8rpx 0 30rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.55;
}
