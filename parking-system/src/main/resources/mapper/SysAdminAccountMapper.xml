<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jushan.platform.modules.account.mapper.SysAdminAccountMapper">

    <!-- 通用查询映射 -->
    <resultMap id="BaseResultMap" type="com.jushan.platform.modules.account.entity.SysAdminAccount">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="company_id" property="companyId"/>
        <result column="lot_id" property="lotId"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="level" property="level"/>
        <result column="status" property="status"/>
        <result column="login_fail_count" property="loginFailCount"/>
        <result column="lock_until" property="lockUntil"/>
        <result column="last_login_time" property="lastLoginTime"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 条件分页查询管理员账号 -->
    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT *
        FROM sys_admin_account
        WHERE deleted_at IS NULL
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        <if test="companyId != null">
            AND company_id = #{companyId}
        </if>
        <if test="lotId != null">
            AND lot_id = #{lotId}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (
                username LIKE CONCAT('%', #{keyword}, '%')
                OR real_name LIKE CONCAT('%', #{keyword}, '%')
                OR phone LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
        ORDER BY created_at DESC
    </select>

</mapper>
