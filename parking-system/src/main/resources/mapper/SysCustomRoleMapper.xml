<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jushan.platform.modules.account.mapper.SysCustomRoleMapper">

    <!-- 通用查询映射 -->
    <resultMap id="BaseResultMap" type="com.jushan.platform.modules.account.entity.SysCustomRole">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="role_name" property="roleName"/>
        <result column="role_code" property="roleCode"/>
        <result column="description" property="description"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 条件分页查询自定义角色 -->
    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT *
        FROM sys_custom_role
        WHERE deleted_at IS NULL
        <if test="tenantId != null">
            AND tenant_id = #{tenantId}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (
                role_name LIKE CONCAT('%', #{keyword}, '%')
                OR role_code LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
        ORDER BY created_at DESC
    </select>

</mapper>
