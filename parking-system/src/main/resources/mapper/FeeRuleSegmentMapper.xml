<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jushan.platform.modules.parking.mapper.FeeRuleSegmentMapper">

    <select id="selectListByFeeRuleId" resultType="com.jushan.platform.modules.parking.entity.FeeRuleSegment">
        SELECT *
        FROM fee_rule_segment
        WHERE fee_rule_id = #{feeRuleId}
          AND deleted_at IS NULL
        ORDER BY sort_order ASC, start_time ASC
    </select>

</mapper>
