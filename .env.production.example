# =============================================================================
# 智慧停车 SaaS 平台 — 生产环境变量配置
# =============================================================================
# 用法：
#   cp .env.production.example .env.production
#   vim .env.production  → 填入真实值
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# =============================================================================
# 标记说明：
#   [必填] — 生产环境必须设置，缺失将导致启动失败或安全风险
#   [建议] — 建议显式设置，有合理默认值
#   [可选] — 有默认值，通常无需修改
# =============================================================================

# ====== MySQL [必填] ======
DB_ROOT_PASSWORD=<生成32位强密码>
DB_NAME=jushan_platform
DB_USERNAME=jushan
DB_PASSWORD=<生成强密码>
DB_POOL_MAX=20
DB_POOL_MIN=5

# ====== MySQL 内存调优 [建议] ======
# 按服务器可用内存调整，建议 innodb_buffer_pool = 总内存 * 50%~70%
# 4G 服务器 → 1G；8G 服务器 → 2G~4G
MYSQL_INNODB_BUFFER_POOL=512M
MYSQL_INNODB_LOG_FILE_SIZE=256M
MYSQL_INNODB_FLUSH_LOG=2
MYSQL_INNODB_IO_CAPACITY=200
MYSQL_INNODB_IO_CAPACITY_MAX=2000

# ====== Redis [必填] ======
REDIS_PASSWORD=<生成强密码>
REDIS_MAXMEMORY=256mb
REDIS_POOL_MAX=8

# ====== RabbitMQ [建议] ======
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=<生成强密码>
RABBITMQ_VHOST=/

# ====== Nginx [可选] ======
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# NGINX_SERVER_NAME=parking.example.com

# ====== JWT [必填] ======
# 生成方式：openssl rand -base64 48
JWT_SECRET=<生成至少32字符的随机密钥>
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ====== 微信小程序 [条件必填] ======
# 如不使用小程序端可留空，mock-login=true 时也可留空
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# ====== Device Access [待启用] ======
DEVICE_ACCESS_WEBHOOK_ALLOWED_IPS=127.0.0.1
JUSHAN_DEVICE_ACCESS_BASE_URL=http://127.0.0.1:8082
JUSHAN_DEVICE_ACCESS_API_KEY=
JUSHAN_WHITELIST_SYNC_API_KEY=

# ====== JVM 调优 [建议] ======
# 按服务器内存调整：2G 服务器 → Xms512m Xmx1g；4G+ → Xms1g Xmx2g
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ====== 镜像标签 [可选] ======
IMAGE_TAG=latest
