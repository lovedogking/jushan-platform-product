# =============================================================================
# 智慧停车 SaaS 平台 — 环境变量配置说明
# =============================================================================
# 用法：部署前复制为 .env（已 gitignore），按实际环境填入真实值。
#   cp .env.example .env
# =============================================================================
# 标记说明：
#   [必填]   — 生产环境缺失将导致启动失败
#   [建议]   — 建议显式设置，有合理默认值
#   [可选]   — 有默认值，通常无需修改
#   [待启用] — 对应模块尚未开发，暂不生效
# =============================================================================
# Docker Compose 本地开发快速配置（复制到 .env 即可使用）：
#   DB_ROOT_PASSWORD=root
#   DB_PORT=3307
#   DB_USERNAME=jushan
#   DB_PASSWORD=jushan_dev
#   REDIS_PORT=6378
#   NGINX_PORT=8088
# =============================================================================

# ====== Docker Compose 端口映射 [可选] ======
# 以下端口为宿主机映射端口，避免与已有本地服务冲突
DB_PORT=3307
REDIS_PORT=6378
NGINX_PORT=8088

# ====== MySQL [可选] ======
DB_ROOT_PASSWORD=<生成强密码>
DB_NAME=jushan_platform
DB_USERNAME=jushan
DB_PASSWORD=<生成强密码>

# ====== 服务端口 [可选] ======
SERVER_PORT=8080

# ====== Redis ======
REDIS_HOST=redis
REDIS_PORT_INT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ====== RabbitMQ ======
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=<生成强密码>
RABBITMQ_VHOST=/
# 容器内 AMQP 端口映射到宿主机的端口（避免与本地已有的 RabbitMQ 冲突）
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ====== Sa-Token ======
SA_TOKEN_NAME=Authorization
SA_TOKEN_TIMEOUT=86400
SA_TOKEN_ACTIVE_TIMEOUT=1800

# ====== 微信支付 [待启用 - T42] ======
# WX_APP_ID=<小程序 AppId>
# WX_APP_SECRET=<小程序 AppSecret>
# WX_MCH_ID=<商户号>
# WX_MCH_SERIAL_NO=<商户证书序列号>
# WX_API_V3_KEY=<API v3 密钥>
# WX_PAY_NOTIFY_URL=https://api.example.com/api/v1/payment/notify

# ====== Device Access [待启用 - T23] ======
# DEVICE_ACCESS_BASE_URL=http://device-access:8080
# DEVICE_ACCESS_TIMEOUT_MS=12000

# ====== 对象存储 [待启用] ======
# OSS_ENDPOINT=http://minio:9000
# OSS_ACCESS_KEY=minioadmin
# OSS_SECRET_KEY=<生成强密码>
# OSS_BUCKET=jushan

# ====== 其他 [建议] ======
# TZ=Asia/Shanghai
